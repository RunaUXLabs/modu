{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@design-system": ["src/design-system/index.ts"],
      "@design-system/*": ["src/design-system/*"]
    },
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "module": "esnext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["src/**/*.jsx", "src/**/*.js"]
}
