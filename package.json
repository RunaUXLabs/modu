{
  "name": "modu",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": "12.11.2"
  },
  "scripts": {
    "check": "vitest run && vitest run --config vitest.service.config.ts && vite build && tsc -p tsconfig.storybook.json --noEmit && storybook build -o storybook-static && node scripts/assemble-pages.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006 --no-open",
    "typecheck:storybook": "tsc -p tsconfig.storybook.json --noEmit",
    "build:storybook": "tsc -p tsconfig.storybook.json --noEmit && storybook build -o storybook-static",
    "build:pages": "vite build && tsc -p tsconfig.storybook.json --noEmit && storybook build -o storybook-static && node scripts/assemble-pages.mjs",
    "test": "vitest run",
    "test:service-stories": "vitest run --config vitest.service.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^5.4.11",
    "storybook": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-a11y": "10.6.2",
    "@types/node": "^22.13.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
